# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Backend Configuration
PYTHONUNBUFFERED=1
PYTHONPATH=.

# Optional: Set to 'true' to enable debug mode
# DEBUG=true

# Optional: Set the port for the backend server (default: 8000)
# PORT=8000

# Optional: Set the frontend port (handled by Vite)
# VITE_PORT=3000

# Optional: Enable/disable GPU acceleration for AI models (true/false)
# USE_CUDA=true
